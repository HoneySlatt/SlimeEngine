# The small cases of mistakes: a list of rows, the row selected filled with the accent, the one
# playing with the theme's secondary container.

[table]
select = { classes = ["table"] }
style.layout.grow = 1

[row-selected]
select = { classes = ["row"], states = ["Selected"] }
style.paint.background = "$accent"

[row-playing]
select = { classes = ["row", "playing"] }
style.paint.background = "$secondary_container"

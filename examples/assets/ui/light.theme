# The light theme of the `interface` example: the same names as the dark one's, other values.
background = "#F1F3F5"
bar = "#E3E7EB"
panel = "#FFFFFF"
panel_border = "#D5DAE0"
shadow = "#00000026"
text = "#212529"
button = "#F8F9FA"
button_border = "#C3C9D0"
pressed = "#4C6EF5"
pressed_border = "#364FC7"
hover = "#E9ECEF"
focus = "#364FC7"
field = "#FFFFFF"
selection = "#4C6EF566"
scrim = "#00000055"
row = "#F1F3F5"
row_odd = "#F8F9FA"
row_text = "#343A40"
selected = "#4C6EF5"
selected_text = "#FFFFFF"
card = "#FFFFFFCC"
card_border = "#ADB5BD99"
card_shadow = "#00000033"

# The core's roles, the colors that uwui's components read by default
# (docs/adr/0230-the-cores-roles-and-each-kinds-defaults.md): the scroll bars, and the fields'
# marks, placeholders and selections.
canvas_text = "$text"
gray_text = "$row_text"
button_face = "$button"
accent = "$pressed"
highlight = "$selected"
highlight_text = "$selected_text"

# The dark theme of the `interface` example: the values that its style sheet names, colors in sRGB.
background = "#1B1C1F"
bar = "#2B2D31"
panel = "#26282C"
panel_border = "#3A3D43"
shadow = "#00000073"
text = "#E3E5E8"
button = "#3A3D43"
button_border = "#4E525A"
pressed = "#4C6EF5"
pressed_border = "#6C8CFF"
hover = "#45484F"
focus = "#8CA4FF"
field = "#1F2124"
selection = "#3B5BDB99"
scrim = "#00000099"
row = "#2E3035"
row_odd = "#292B30"
row_text = "#C9CDD4"
selected = "#3B5BDB"
selected_text = "#FFFFFF"
card = "#202226CC"
card_border = "#5F636899"
card_shadow = "#00000080"

# The core's roles, the colors that uwui's components read by default
# (docs/adr/0230-the-cores-roles-and-each-kinds-defaults.md): the scroll bars, and the fields'
# marks, placeholders and selections.
canvas_text = "$text"
gray_text = "$row_text"
button_face = "$button"
accent = "$pressed"
highlight = "$selected"
highlight_text = "$selected_text"

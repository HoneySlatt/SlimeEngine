// The editor's shortcuts: each chord, and the name of the operation that it runs
// (`crates/slime-editor/src/operation.rs`, `docs/adr/0156-the-editors-window-and-its-operations.md`).

scope global {
    Primary+O file.choose
    Primary+S file.save
    Primary+Q file.quit
    Primary+Z edit.undo
    Primary+Shift+Z edit.redo
    Primary+Y edit.redo
    Primary+Shift+A edit.select_none
    Primary+Shift+P view.palette
    F1 view.shortcuts
    F view.frame_selection
    W edit.handles_move
    E edit.handles_turn
    R edit.handles_scale
    End edit.drop
    Shift+End edit.drop_bottom
    Primary+Shift+N edit.create
    Delete edit.delete
    Primary+D edit.duplicate
    Primary+C edit.copy
    Primary+V edit.paste
    Primary+G edit.group
    F2 edit.rename
    Shift+R edit.repeat
    Primary+ArrowLeft edit.nudge_left
    Primary+ArrowRight edit.nudge_right
    Primary+ArrowUp edit.nudge_forward
    Primary+ArrowDown edit.nudge_back
    Primary+PageUp edit.nudge_up
    Primary+PageDown edit.nudge_down
    F5 play.start
    Shift+F5 play.stop
    F7 play.pause
    F8 play.step
}

// While the hierarchy's rows hold the focus (`docs/adr/0167-the-hierarchy.md`,
// `docs/adr/0168-rearranging-the-hierarchy.md`).
scope hierarchy {
    ArrowUp hierarchy.previous
    ArrowDown hierarchy.next
    ArrowLeft hierarchy.fold
    ArrowRight hierarchy.unfold
    Alt+ArrowUp hierarchy.move_up
    Alt+ArrowDown hierarchy.move_down
    Alt+ArrowLeft hierarchy.outdent
    Alt+ArrowRight hierarchy.indent
}

// What the buttons of the mouse do over the viewport: a gesture that moves the camera while the
// button is held, `fly`, `orbit` or `pan`, or `select`, a click or a marquee, or `through`, a click
// through what lies behind. A button's chord holds with more modifiers held, the one that names the
// most winning: Shift and the left button select too, adding (`uwui::shortcuts`).
scope viewport {
    RightButton fly
    Alt+LeftButton orbit
    MiddleButton pan
    LeftButton select
}

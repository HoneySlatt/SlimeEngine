# The editor's shortcuts: each chord, and the name of the operation that it runs
# (`crates/slime-editor/src/operation.rs`, `docs/adr/0156-the-editors-window-and-its-operations.md`).

[global]
"Ctrl+O" = "file.choose"
"Ctrl+S" = "file.save"
"Ctrl+Q" = "file.quit"
"Ctrl+Z" = "edit.undo"
"Ctrl+Shift+Z" = "edit.redo"
"Ctrl+Y" = "edit.redo"
"Ctrl+Shift+A" = "edit.select_none"
"Ctrl+Shift+P" = "view.palette"
F1 = "view.shortcuts"
F = "view.frame_selection"
W = "edit.handles_move"
E = "edit.handles_turn"
R = "edit.handles_scale"
End = "edit.drop"
"Shift+End" = "edit.drop_bottom"
"Ctrl+Shift+N" = "edit.create"
Delete = "edit.delete"
"Ctrl+D" = "edit.duplicate"
"Ctrl+C" = "edit.copy"
"Ctrl+V" = "edit.paste"
"Ctrl+G" = "edit.group"
"Shift+R" = "edit.repeat"
"Ctrl+ArrowLeft" = "edit.nudge_left"
"Ctrl+ArrowRight" = "edit.nudge_right"
"Ctrl+ArrowUp" = "edit.nudge_forward"
"Ctrl+ArrowDown" = "edit.nudge_back"
"Ctrl+PageUp" = "edit.nudge_up"
"Ctrl+PageDown" = "edit.nudge_down"
F5 = "play.start"
"Shift+F5" = "play.stop"
F7 = "play.pause"
F8 = "play.step"

# What the buttons of the mouse do over the viewport: a gesture that moves the camera while the
# button is held, `fly`, `orbit` or `pan`, or `select`, a click or a marquee, or `through`, a click
# through what lies behind. A button's chord holds with more modifiers held, the one that names the
# most winning: Shift and the left button select too, adding (`slime_ui::shortcuts`).
[viewport]
RightButton = "fly"
"Alt+LeftButton" = "orbit"
MiddleButton = "pan"
LeftButton = "select"

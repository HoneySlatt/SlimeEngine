// The style sheet of the editor's look (docs/adr/0148-widgets.md,
// docs/adr/0149-the-looks-foundations.md): each node is a rule, applied in the order of this file,
// that sets a part of the style of the elements it selects (docs/adr/0141-style-sheets-and-themes.md).
// Its values come from the look's themes, `base.theme.kdl` and a theme of colors stacked on it,
// which name them for it, the icons that controls draw among them. Text is in Geist, its digits of
// one width, and in Geist Mono where an element holds the class `fixed`. Changes move over the base
// theme's durations. Elements that take the focus show it to the keyboard by the color of a border
// of one pixel that they always keep, transparent until then for those that show none otherwise,
// so that the focus moves nothing; a field shows it whatever gave it, as browsers do; the handle
// between two panels shows it by its fill.

everything {
    select
    text color=$text selection=$selection { style size=$text_m { fonts Geist; features tnum } }
    transition duration=$fast easing=EaseOut
    icons font=$icon_font tick=$icon_tick down=$icon_down right=$icon_right left=$icon_left \
        search=$icon_search clear=$icon_clear
}

window {
    select { classes window }
    paint background=$background
}

// What lies below a modal layer, which takes no input while it is open, dimmed.
modal {
    select { classes modal }
    paint backdrop=$scrim
}

bar {
    select { classes bar }
    paint background=$bar
}

panel {
    select { classes panel }
    paint background=$panel border_width=1 border=$panel_border {
        radii $radius_l $radius_l $radius_l $radius_l
    }
}

muted {
    select kind=Label { classes muted }
    text color=$muted
}

button {
    select kind=Button
    paint background=$raised border_width=1 border=$raised_border {
        radii $radius_m $radius_m $radius_m $radius_m
    }
    layout { padding start=$button_x end=$button_x top=$button_y bottom=$button_y }
    text { style weight=$weight_control }
}

button-hovered {
    select kind=Button { states Hovered }
    paint background=$hover
}

button-pressed {
    select kind=Button { states Pressed }
    paint background=$pressed
}

button-focused {
    select kind=Button { states FocusVisible }
    paint border=$focus
}

button-disabled {
    select kind=Button { states Disabled }
    text color=$muted
}

field {
    select kind=TextField
    paint background=$field border_width=1 border=$raised_border {
        radii $radius_m $radius_m $radius_m $radius_m
    }
    layout { padding start=$field_x end=$field_x top=$field_y bottom=$field_y }
    control size=$control track=$muted mark=$muted
}

number {
    select kind=NumberField
    paint background=$field border_width=1 border=$raised_border {
        radii $radius_m $radius_m $radius_m $radius_m
    }
    layout { padding start=$field_x end=$field_x top=$field_y bottom=$field_y }
    control size=$control track=$muted mark=$muted
    text { style size=$text_mono { fonts "Geist Mono" } }
}

field-hovered {
    select kind=TextField { states Hovered }
    paint border=$track
}

number-hovered {
    select kind=NumberField { states Hovered }
    paint border=$track
}

field-focused {
    select kind=TextField { states Focused }
    paint border=$focus
}

number-focused {
    select kind=NumberField { states Focused }
    paint border=$focus
}

check-box {
    select kind=CheckBox
    paint border_width=1 border=$none { radii $radius_m $radius_m $radius_m $radius_m }
    layout { padding start=$space_xs end=$space_s top=$space_xs bottom=$space_xs }
    control size=$control radius=$radius_s track=$track fill=$accent mark=$mark
}

check-box-hovered {
    select kind=CheckBox { states Hovered }
    control track=$track_hover fill=$accent_hover
}

check-box-focused {
    select kind=CheckBox { states FocusVisible }
    paint border=$focus
}

slider {
    select kind=Slider
    paint border_width=1 border=$none { radii $radius_m $radius_m $radius_m $radius_m }
    layout { padding start=$space_xs end=$space_xs top=$space_xs bottom=$space_xs }
    control size=$control radius=7 track=$track fill=$accent mark=$thumb
}

slider-hovered {
    select kind=Slider { states Hovered }
    control track=$track_hover fill=$accent_hover
}

slider-focused {
    select kind=Slider { states FocusVisible }
    paint border=$focus
}

section {
    select kind=Section
    paint border_width=1 border=$none { radii $radius_m $radius_m $radius_m $radius_m }
    layout { padding start=$space_s end=$space_s top=$space_xs bottom=$space_s }
    text { style weight=$weight_title }
    control size=$control radius=$radius_s track=$raised mark=$text
    transition duration=$slow easing=EaseInOut
}

section-header {
    select kind=SectionHeader
    layout align_items=Center { gap 0 $space_s }
}

section-header-button {
    select kind=Button { inside kind=SectionHeader }
    layout { padding start=$space_m end=$space_m top=0 bottom=0 }
    text { style size=$text_s }
}

section-hovered {
    select kind=Section { states Hovered }
    control track=$hover
}

section-focused {
    select kind=Section { states FocusVisible }
    paint border=$focus
}

toggle-button {
    select kind=ToggleButton
    paint background=$raised border_width=1 border=$raised_border {
        radii $radius_m $radius_m $radius_m $radius_m
    }
    layout { padding start=$button_x end=$button_x top=$button_y bottom=$button_y }
    text { style weight=$weight_control }
}

toggle-button-hovered {
    select kind=ToggleButton { states Hovered }
    paint background=$hover
}

toggle-button-on {
    select kind=ToggleButton { states Checked }
    paint background=$accent_soft border=$accent
}

toggle-button-focused {
    select kind=ToggleButton { states FocusVisible }
    paint border=$focus
}

segments {
    select kind=Segments
    paint background=$field border_width=1 border=$raised_border {
        radii $radius_m $radius_m $radius_m $radius_m
    }
    layout { padding start=$space_xs end=$space_xs top=$space_xs bottom=$space_xs; gap 0 $space_xs }
}

segment {
    select kind=Segment
    paint border_width=1 border=$none { radii $radius_s $radius_s $radius_s $radius_s }
    layout { padding start=$button_x end=$button_x top=$button_y bottom=$button_y }
    text color=$muted { style weight=$weight_control }
}

segment-hovered {
    select kind=Segment { states Hovered }
    text color=$text
}

segment-chosen {
    select kind=Segment { states Selected }
    paint background=$raised
    text color=$text
}

segment-focused {
    select kind=Segment { states FocusVisible }
    paint border=$focus
}

progress {
    select kind=Progress
    control size=$control radius=$radius_s track=$track fill=$accent
}

tab-bar {
    select kind=TabBar
    paint background=$bar
    layout { padding start=$space_m end=$space_m top=$space_s bottom=0; gap 0 $space_xs }
}

tab {
    select kind=Tab
    paint border_width=1 border=$none { radii $radius_m $radius_m 0 0 }
    layout { padding start=$tab_x end=$tab_x top=$tab_y bottom=$tab_y }
    text color=$muted { style weight=$weight_control }
    control size=$control track=$accent_soft mark=$text
}

tab-hovered {
    select kind=Tab { states Hovered }
    text color=$text
}

tab-chosen {
    select kind=Tab { states Selected }
    paint background=$panel
    text color=$text
}

tab-focused {
    select kind=Tab { states FocusVisible }
    paint border=$focus
}

split {
    select kind=Split
    control size=$handle track=$panel_border fill=$accent
}

// A dock's stack of tabs (docs/adr/0172-regions-of-tabs.md): a panel's box, its bar of tabs along
// its top, what the chosen panel holds below, and the borders between stacks, which show as the
// pointer comes over them.
stack {
    select { classes stack }
    paint background=$panel border_width=1 border=$panel_border {
        radii $radius_l $radius_l $radius_l $radius_l
    }
}

stack-tabs {
    select kind=TabBar key=tabs { inside class=stack }
    paint { radii $radius_l $radius_l 0 0 }
}

stack-panel {
    select { classes tab-panel }
    layout { padding start=$space_m end=$space_m top=$space_m bottom=$space_m }
}

splitter-hovered {
    select kind=Splitter { states Hovered }
    paint background=$hover
}

splitter-pressed {
    select kind=Splitter { states Pressed }
    paint background=$accent_soft
}

scroll {
    select kind=Scroll
    control size=$scroll_bar radius=$radius_s track=$bar_track mark=$bar_thumb
}

list {
    select kind=List
    control size=$scroll_bar radius=$radius_s track=$bar_track mark=$bar_thumb
}

menu-bar {
    select kind=MenuBar
    paint background=$bar
    layout { padding start=$space_s end=$space_s top=$space_xs bottom=$space_xs; gap 0 $space_xs }
}

menu {
    select kind=Menu
    paint background=$raised border_width=1 border=$raised_border {
        radii $radius_l $radius_l $radius_l $radius_l
        shadow color=$shadow blur=$shadow_blur spread=0 { offset 0 $shadow_y }
    }
    layout direction=Column {
        padding start=$space_xs end=$space_xs top=$space_xs bottom=$space_xs
        min_size $menu_width Auto
    }
}

menu-separator {
    select { classes separator; inside kind=Menu }
    paint background=$raised_border
    layout { size Auto 1; margin start=$space_s end=$space_s top=$space_xs bottom=$space_xs }
}

menu-item {
    select kind=MenuItem
    paint border_width=1 border=$none { radii $radius_s $radius_s $radius_s $radius_s }
    layout { padding start=$space_s end=$space_s top=$button_y bottom=$button_y }
    control size=$control track=$muted mark=$text
}

menu-item-focused {
    select kind=MenuItem { states Focused }
    paint background=$accent_soft
}

menu-item-open {
    select kind=MenuItem { states Expanded }
    paint background=$hover
}

menu-item-disabled {
    select kind=MenuItem { states Disabled }
    text color=$muted
}

menu-bar-item {
    select kind=MenuItem { inside kind=MenuBar }
    layout { padding start=$space_m end=$space_m top=$button_y bottom=$button_y }
}

menu-bar-item-hovered {
    select kind=MenuItem { states Hovered; inside kind=MenuBar }
    paint background=$hover
}

menu-bar-item-focused {
    select kind=MenuItem { states FocusVisible; inside kind=MenuBar }
    paint border=$focus
}

menu-bar-item-open {
    select kind=MenuItem { states Expanded; inside kind=MenuBar }
    paint background=$accent_soft
}

choice {
    select kind=Choice
    paint background=$raised border_width=1 border=$raised_border {
        radii $radius_m $radius_m $radius_m $radius_m
    }
    layout { padding start=$field_x end=$field_x top=$button_y bottom=$button_y }
    control size=$control mark=$muted
}

choice-hovered {
    select kind=Choice { states Hovered }
    paint background=$hover
}

choice-open {
    select kind=Choice { states Expanded }
    paint background=$pressed
}

choice-focused {
    select kind=Choice { states FocusVisible }
    paint border=$focus
}

tooltip {
    select { classes tooltip }
    paint background=$raised border_width=1 border=$raised_border {
        radii $radius_m $radius_m $radius_m $radius_m
        shadow color=$shadow blur=$shadow_blur spread=0 { offset 0 $shadow_y }
    }
    layout {
        padding start=$space_m end=$space_m top=$space_s bottom=$space_s
        max_size $tooltip_width Auto
    }
}

tooltip-text {
    select kind=Label { inside class=tooltip }
    text { style size=$text_s }
}

tooltip-title {
    select kind=Label { classes tooltip-title }
    text { style weight=$weight_title }
}

floating-panel {
    select kind=FloatingPanel
    paint background=$panel border_width=1 border=$panel_border {
        radii $radius_l $radius_l $radius_l $radius_l
        shadow color=$shadow blur=$shadow_blur spread=0 { offset 0 $shadow_y }
    }
    layout { padding start=$space_m end=$space_m top=$space_s bottom=$space_m }
    text { style weight=$weight_title }
    control size=$control radius=$radius_s track=$muted mark=$text
}

floating-panel-focused {
    select kind=FloatingPanel { states FocusVisible }
    paint border=$focus
}

axis-x {
    select kind=NumberField { classes axis-x }
    control mark=$axis_x
}

axis-y {
    select kind=NumberField { classes axis-y }
    control mark=$axis_y
}

axis-z {
    select kind=NumberField { classes axis-z }
    control mark=$axis_z
}

palette {
    select { classes palette }
    paint background=$raised border_width=1 border=$raised_border {
        radii $radius_l $radius_l $radius_l $radius_l
        shadow color=$shadow blur=$shadow_blur spread=0 { offset 0 $shadow_y }
    }
    layout { padding start=$space_s end=$space_s top=$space_s bottom=$space_s; gap $space_s 0 }
}

palette-row-chosen {
    select kind=MenuItem { states Selected; inside class=palette }
    paint background=$accent_soft
}

sheet {
    select { classes sheet }
    paint background=$raised border_width=1 border=$raised_border {
        radii $radius_l $radius_l $radius_l $radius_l
        shadow color=$shadow blur=$shadow_blur spread=0 { offset 0 $shadow_y }
    }
    layout { padding start=$space_l end=$space_l top=$space_l bottom=$space_l; gap $space_xs 0 }
}

// A dialog over the window, as the one that waits for the system's dialog to open a level.
dialog {
    select { classes dialog }
    paint background=$raised border_width=1 border=$raised_border {
        radii $radius_l $radius_l $radius_l $radius_l
        shadow color=$shadow blur=$shadow_blur spread=0 { offset 0 $shadow_y }
    }
    layout {
        padding start=$space_l end=$space_l top=$space_l bottom=$space_l
        gap $space_m $space_m
    }
}

sheet-title {
    select kind=Label { classes sheet-title }
    text { style weight=$weight_title }
}

sheet-scope {
    select kind=Label { classes sheet-scope }
    text color=$muted { style size=$text_s weight=$weight_control }
    layout { margin start=0 end=0 top=$space_s bottom=0 }
}

notification {
    select { classes notification }
    paint background=$panel border_width=1 border=$raised_border {
        radii $radius_m $radius_m $radius_m $radius_m
        shadow color=$shadow blur=$shadow_blur spread=0 { offset 0 $shadow_y }
    }
    layout {
        padding start=$space_m end=$space_s top=$space_s bottom=$space_m
        size $notification_width Auto
    }
}

notification-success {
    select { classes notification success }
    paint border=$success
}

notification-warning {
    select { classes notification warning }
    paint border=$warning
}

notification-error {
    select { classes notification error }
    paint border=$danger
}

notification-close {
    select kind=Button { classes close; inside class=notification }
    paint background=$none border=$none
    layout { padding start=$space_xs end=$space_xs top=0 bottom=0 }
    text color=$muted
}

notification-close-hovered {
    select kind=Button { classes close; states Hovered; inside class=notification }
    text color=$text
}

notification-close-focused {
    select kind=Button { classes close; states FocusVisible; inside class=notification }
    paint border=$focus
}

// A color well and its picker (docs/adr/0152-the-dev-overlay-on-the-engines-interface.md): the
// swatch inside a field's frame; the picker raised as a menu is; its square and strips rounded,
// ringed in the accent while the keyboard's focus is on them.
color-well {
    select kind=ColorWell
    paint background=$field border_width=1 border=$raised_border {
        radii $radius_m $radius_m $radius_m $radius_m
    }
    layout { padding start=2 end=2 top=2 bottom=2 }
    control size=$control radius=$radius_s
}

color-well-focused {
    select kind=ColorWell { states FocusVisible }
    paint border=$focus
}

picker {
    select { classes picker }
    paint background=$raised border_width=1 border=$raised_border {
        radii $radius_l $radius_l $radius_l $radius_l
        shadow color=$shadow blur=$shadow_blur spread=0 { offset 0 $shadow_y }
    }
    layout { padding start=$space_m end=$space_m top=$space_m bottom=$space_m }
}

color-part {
    select kind=ColorPart
    control radius=$radius_s fill=$accent
}

// The dev overlay's panels (docs/adr/0152-the-dev-overlay-on-the-engines-interface.md): a list's
// rows, which select, the entity selected among them; references, which read as links; a heading;
// a refusal.
row {
    select kind=Button { classes row }
    paint background=$none border=$none { radii $radius_s $radius_s $radius_s $radius_s }
    layout { padding start=$space_s end=$space_s top=0 bottom=0 }
}

row-hovered {
    select kind=Button { classes row; states Hovered }
    paint background=$hover
}

row-selected {
    select kind=Button { classes row; states Selected }
    paint background=$accent_soft
}

row-focused {
    select kind=Button { classes row; states FocusVisible }
    paint border=$focus
}

// The marks of a tree's row that a press turns, drawn in Lucide: the chevron that folds and unfolds
// it (docs/adr/0167-the-hierarchy.md), its eye and its lock (docs/adr/0169-the-eye-and-the-lock.md);
// and the name of a row that is hidden, dimmed.
mark {
    select kind=Button { classes mark }
    paint background=$none border=$none
    text color=$muted { style { fonts lucide } }
    layout { padding start=0 end=0 top=0 bottom=0 }
}

mark-hovered {
    select kind=Button { classes mark; states Hovered }
    text color=$text
}

mark-focused {
    select kind=Button { classes mark; states FocusVisible }
    paint border=$focus
}

row-hidden {
    select kind=Button { classes row hidden }
    text color=$muted
}

// An icon that a label shows, drawn in Lucide, as a tree's mark of a placement.
icon {
    select kind=Label { classes icon }
    text color=$muted { style { fonts lucide } }
}

// Where a drag of a tree's rows would drop what it carries: a line between two rows, or the box of
// the row that it goes into (docs/adr/0168-rearranging-the-hierarchy.md).
drop-line {
    select { classes drop-line }
    paint background=$accent { radii $radius_s $radius_s $radius_s $radius_s }
}

drop-into {
    select { classes drop-into }
    paint background=$accent_soft border_width=1 border=$accent {
        radii $radius_s $radius_s $radius_s $radius_s
    }
}

// A row of what is undone, as the editor's history shows a step undone.
row-undone {
    select kind=Button { classes row undone }
    text color=$muted
}

link {
    select kind=Button { classes link }
    paint background=$none border=$none
    layout { padding start=0 end=0 top=0 bottom=0 }
    text color=$accent
}

link-hovered {
    select kind=Button { classes link; states Hovered }
    text color=$accent_hover
}

link-focused {
    select kind=Button { classes link; states FocusVisible }
    paint border=$focus
}

heading {
    select kind=Label { classes heading }
    text { style weight=$weight_title }
}

refusal {
    select kind=Label { classes error }
    text color=$danger
}

fixed {
    select { classes fixed }
    text { style size=$text_mono { fonts "Geist Mono" } }
}

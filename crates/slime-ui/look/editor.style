# The style sheet of the editor's look (docs/adr/0148-widgets.md,
# docs/adr/0149-the-looks-foundations.md): each table is a rule, applied in the order of this file, that sets a part of the style of the
# elements it selects (docs/adr/0141-style-sheets-and-themes.md). Its values come from the look's
# themes, `base.theme` and a theme of colors stacked on it, which name them for it. Text is in Geist,
# its digits of one width, and in Geist Mono where an element holds the class `fixed`. Changes move
# over the base theme's durations. Elements that take the focus show it to the keyboard by the color
# of a border of one pixel that they always keep, transparent until then for those that show none
# otherwise, so that the focus moves nothing; a field shows it whatever gave it, as browsers do; the
# handle between two panels shows it by its fill.

[everything]
select = {}
style.text = { style = { fonts = ["Geist"], size = "$text_m", features = ["tnum"] }, color = "$text", selection = "$selection" }
style.transition = { duration = "$fast", easing = "EaseOut" }
# Lucide's `check`, `chevron-down`, `chevron-right`, `chevron-left`, `search` and `x`, by their
# codepoints, which `Lucide.codepoints.json` names; a sheet after this one names others.
style.icons = { font = "lucide", tick = "\uE06C", down = "\uE06D", right = "\uE06F", left = "\uE06E", search = "\uE151", clear = "\uE1B2" }

[window]
select = { classes = ["window"] }
style.paint.background = "$background"

# What lies below a modal layer, which takes no input while it is open, dimmed.
[modal]
select = { classes = ["modal"] }
style.paint.backdrop = "$scrim"

[bar]
select = { classes = ["bar"] }
style.paint.background = "$bar"

[panel]
select = { classes = ["panel"] }
style.paint = { background = "$panel", border_width = 1, border = "$panel_border", radii = ["$radius_l", "$radius_l", "$radius_l", "$radius_l"] }

[muted]
select = { kind = "Label", classes = ["muted"] }
style.text.color = "$muted"

[button]
select = { kind = "Button" }
style.paint = { background = "$raised", border_width = 1, border = "$raised_border", radii = ["$radius_m", "$radius_m", "$radius_m", "$radius_m"] }
style.layout.padding = { start = "$button_x", end = "$button_x", top = "$button_y", bottom = "$button_y" }
style.text.style.weight = "$weight_control"

[button-hovered]
select = { kind = "Button", states = ["Hovered"] }
style.paint.background = "$hover"

[button-pressed]
select = { kind = "Button", states = ["Pressed"] }
style.paint.background = "$pressed"

[button-focused]
select = { kind = "Button", states = ["FocusVisible"] }
style.paint.border = "$focus"

[button-disabled]
select = { kind = "Button", states = ["Disabled"] }
style.text.color = "$muted"

[field]
select = { kind = "TextField" }
style.paint = { background = "$field", border_width = 1, border = "$raised_border", radii = ["$radius_m", "$radius_m", "$radius_m", "$radius_m"] }
style.layout.padding = { start = "$field_x", end = "$field_x", top = "$field_y", bottom = "$field_y" }
style.control = { size = "$control", track = "$muted", mark = "$muted" }

[number]
select = { kind = "NumberField" }
style.paint = { background = "$field", border_width = 1, border = "$raised_border", radii = ["$radius_m", "$radius_m", "$radius_m", "$radius_m"] }
style.layout.padding = { start = "$field_x", end = "$field_x", top = "$field_y", bottom = "$field_y" }
style.control = { size = "$control", track = "$muted", mark = "$muted" }
style.text.style = { fonts = ["Geist Mono"], size = "$text_mono" }

[field-hovered]
select = { kind = "TextField", states = ["Hovered"] }
style.paint.border = "$track"

[number-hovered]
select = { kind = "NumberField", states = ["Hovered"] }
style.paint.border = "$track"

[field-focused]
select = { kind = "TextField", states = ["Focused"] }
style.paint.border = "$focus"

[number-focused]
select = { kind = "NumberField", states = ["Focused"] }
style.paint.border = "$focus"

[check-box]
select = { kind = "CheckBox" }
style.paint = { border_width = 1, border = "$none", radii = ["$radius_m", "$radius_m", "$radius_m", "$radius_m"] }
style.layout.padding = { start = "$space_xs", end = "$space_s", top = "$space_xs", bottom = "$space_xs" }
style.control = { size = "$control", radius = "$radius_s", track = "$track", fill = "$accent", mark = "$mark" }

[check-box-hovered]
select = { kind = "CheckBox", states = ["Hovered"] }
style.control = { track = "$track_hover", fill = "$accent_hover" }

[check-box-focused]
select = { kind = "CheckBox", states = ["FocusVisible"] }
style.paint.border = "$focus"

[slider]
select = { kind = "Slider" }
style.paint = { border_width = 1, border = "$none", radii = ["$radius_m", "$radius_m", "$radius_m", "$radius_m"] }
style.layout.padding = { start = "$space_xs", end = "$space_xs", top = "$space_xs", bottom = "$space_xs" }
style.control = { size = "$control", radius = 7, track = "$track", fill = "$accent", mark = "$thumb" }

[slider-hovered]
select = { kind = "Slider", states = ["Hovered"] }
style.control = { track = "$track_hover", fill = "$accent_hover" }

[slider-focused]
select = { kind = "Slider", states = ["FocusVisible"] }
style.paint.border = "$focus"

[section]
select = { kind = "Section" }
style.paint = { border_width = 1, border = "$none", radii = ["$radius_m", "$radius_m", "$radius_m", "$radius_m"] }
style.layout.padding = { start = "$space_s", end = "$space_s", top = "$space_xs", bottom = "$space_s" }
style.text.style.weight = "$weight_title"
style.control = { size = "$control", radius = "$radius_s", track = "$raised", fill = "$accent", mark = "$text" }
style.transition = { duration = "$slow", easing = "EaseInOut" }

[section-header]
select = { kind = "SectionHeader" }
style.layout.gap = [0, "$space_s"]
style.layout.align_items = "Center"

[section-header-button]
select = { kind = "Button", inside = { kind = "SectionHeader" } }
style.layout.padding = { start = "$space_m", end = "$space_m", top = 0, bottom = 0 }
style.text.style.size = "$text_s"

[section-hovered]
select = { kind = "Section", states = ["Hovered"] }
style.control.track = "$hover"

[section-focused]
select = { kind = "Section", states = ["FocusVisible"] }
style.paint.border = "$focus"

[toggle-button]
select = { kind = "ToggleButton" }
style.paint = { background = "$raised", border_width = 1, border = "$raised_border", radii = ["$radius_m", "$radius_m", "$radius_m", "$radius_m"] }
style.layout.padding = { start = "$button_x", end = "$button_x", top = "$button_y", bottom = "$button_y" }
style.text.style.weight = "$weight_control"

[toggle-button-hovered]
select = { kind = "ToggleButton", states = ["Hovered"] }
style.paint.background = "$hover"

[toggle-button-on]
select = { kind = "ToggleButton", states = ["Checked"] }
style.paint = { background = "$accent_soft", border = "$accent" }

[toggle-button-focused]
select = { kind = "ToggleButton", states = ["FocusVisible"] }
style.paint.border = "$focus"

[segments]
select = { kind = "Segments" }
style.paint = { background = "$field", border_width = 1, border = "$raised_border", radii = ["$radius_m", "$radius_m", "$radius_m", "$radius_m"] }
style.layout.padding = { start = "$space_xs", end = "$space_xs", top = "$space_xs", bottom = "$space_xs" }
style.layout.gap = [0, "$space_xs"]

[segment]
select = { kind = "Segment" }
style.paint = { border_width = 1, border = "$none", radii = ["$radius_s", "$radius_s", "$radius_s", "$radius_s"] }
style.layout.padding = { start = "$button_x", end = "$button_x", top = "$button_y", bottom = "$button_y" }
style.text = { style = { weight = "$weight_control" }, color = "$muted" }

[segment-hovered]
select = { kind = "Segment", states = ["Hovered"] }
style.text.color = "$text"

[segment-chosen]
select = { kind = "Segment", states = ["Selected"] }
style.paint.background = "$raised"
style.text.color = "$text"

[segment-focused]
select = { kind = "Segment", states = ["FocusVisible"] }
style.paint.border = "$focus"

[progress]
select = { kind = "Progress" }
style.control = { size = "$control", radius = "$radius_s", track = "$track", fill = "$accent", mark = "$mark" }

[tab-bar]
select = { kind = "TabBar" }
style.paint.background = "$bar"
style.layout.padding = { start = "$space_m", end = "$space_m", top = "$space_s", bottom = 0 }
style.layout.gap = [0, "$space_xs"]

[tab]
select = { kind = "Tab" }
style.paint = { border_width = 1, border = "$none", radii = ["$radius_m", "$radius_m", 0, 0] }
style.layout.padding = { start = "$tab_x", end = "$tab_x", top = "$tab_y", bottom = "$tab_y" }
style.text = { style = { weight = "$weight_control" }, color = "$muted" }
style.control = { size = "$control", radius = "$radius_s", track = "$accent_soft", fill = "$accent", mark = "$text" }

[tab-hovered]
select = { kind = "Tab", states = ["Hovered"] }
style.text.color = "$text"

[tab-chosen]
select = { kind = "Tab", states = ["Selected"] }
style.paint.background = "$panel"
style.text.color = "$text"

[tab-focused]
select = { kind = "Tab", states = ["FocusVisible"] }
style.paint.border = "$focus"

[split]
select = { kind = "Split" }
style.control = { size = "$handle", radius = 0, track = "$panel_border", fill = "$accent", mark = "$mark" }

[scroll]
select = { kind = "Scroll" }
style.control = { size = "$scroll_bar", radius = "$radius_s", track = "$bar_track", fill = "$accent", mark = "$bar_thumb" }

[list]
select = { kind = "List" }
style.control = { size = "$scroll_bar", radius = "$radius_s", track = "$bar_track", fill = "$accent", mark = "$bar_thumb" }

[menu-bar]
select = { kind = "MenuBar" }
style.paint.background = "$bar"
style.layout.padding = { start = "$space_s", end = "$space_s", top = "$space_xs", bottom = "$space_xs" }
style.layout.gap = [0, "$space_xs"]

[menu]
select = { kind = "Menu" }
style.paint = { background = "$raised", border_width = 1, border = "$raised_border", radii = ["$radius_l", "$radius_l", "$radius_l", "$radius_l"], shadow = [{ color = "$shadow", offset = [0, "$shadow_y"], blur = "$shadow_blur", spread = 0 }] }
style.layout.direction = "Column"
style.layout.padding = { start = "$space_xs", end = "$space_xs", top = "$space_xs", bottom = "$space_xs" }
style.layout.min_size = [{ Pixels = "$menu_width" }, "Auto"]

[menu-separator]
select = { classes = ["separator"], inside = { kind = "Menu" } }
style.paint.background = "$raised_border"
style.layout.size = ["Auto", { Pixels = 1 }]
style.layout.margin = { start = "$space_s", end = "$space_s", top = "$space_xs", bottom = "$space_xs" }

[menu-item]
select = { kind = "MenuItem" }
style.paint = { border_width = 1, border = "$none", radii = ["$radius_s", "$radius_s", "$radius_s", "$radius_s"] }
style.layout.padding = { start = "$space_s", end = "$space_s", top = "$button_y", bottom = "$button_y" }
style.control = { size = "$control", radius = "$radius_s", track = "$muted", fill = "$accent", mark = "$text" }

[menu-item-focused]
select = { kind = "MenuItem", states = ["Focused"] }
style.paint.background = "$accent_soft"

[menu-item-open]
select = { kind = "MenuItem", states = ["Expanded"] }
style.paint.background = "$hover"

[menu-item-disabled]
select = { kind = "MenuItem", states = ["Disabled"] }
style.text.color = "$muted"

[menu-bar-item]
select = { kind = "MenuItem", inside = { kind = "MenuBar" } }
style.layout.padding = { start = "$space_m", end = "$space_m", top = "$button_y", bottom = "$button_y" }

[menu-bar-item-hovered]
select = { kind = "MenuItem", states = ["Hovered"], inside = { kind = "MenuBar" } }
style.paint.background = "$hover"

[menu-bar-item-focused]
select = { kind = "MenuItem", states = ["FocusVisible"], inside = { kind = "MenuBar" } }
style.paint.border = "$focus"

[menu-bar-item-open]
select = { kind = "MenuItem", states = ["Expanded"], inside = { kind = "MenuBar" } }
style.paint.background = "$accent_soft"

[choice]
select = { kind = "Choice" }
style.paint = { background = "$raised", border_width = 1, border = "$raised_border", radii = ["$radius_m", "$radius_m", "$radius_m", "$radius_m"] }
style.layout.padding = { start = "$field_x", end = "$field_x", top = "$button_y", bottom = "$button_y" }
style.control = { size = "$control", radius = "$radius_s", track = "$track", fill = "$accent", mark = "$muted" }

[choice-hovered]
select = { kind = "Choice", states = ["Hovered"] }
style.paint.background = "$hover"

[choice-open]
select = { kind = "Choice", states = ["Expanded"] }
style.paint.background = "$pressed"

[choice-focused]
select = { kind = "Choice", states = ["FocusVisible"] }
style.paint.border = "$focus"

[tooltip]
select = { classes = ["tooltip"] }
style.paint = { background = "$raised", border_width = 1, border = "$raised_border", radii = ["$radius_m", "$radius_m", "$radius_m", "$radius_m"], shadow = [{ color = "$shadow", offset = [0, "$shadow_y"], blur = "$shadow_blur", spread = 0 }] }
style.layout.padding = { start = "$space_m", end = "$space_m", top = "$space_s", bottom = "$space_s" }
style.layout.max_size = [{ Pixels = "$tooltip_width" }, "Auto"]

[tooltip-text]
select = { kind = "Label", inside = { class = "tooltip" } }
style.text.style.size = "$text_s"

[tooltip-title]
select = { kind = "Label", classes = ["tooltip-title"] }
style.text.style.weight = "$weight_title"

[floating-panel]
select = { kind = "FloatingPanel" }
style.paint = { background = "$panel", border_width = 1, border = "$panel_border", radii = ["$radius_l", "$radius_l", "$radius_l", "$radius_l"], shadow = [{ color = "$shadow", offset = [0, "$shadow_y"], blur = "$shadow_blur", spread = 0 }] }
style.layout.padding = { start = "$space_m", end = "$space_m", top = "$space_s", bottom = "$space_m" }
style.text.style.weight = "$weight_title"
style.control = { size = "$control", radius = "$radius_s", track = "$muted", fill = "$accent", mark = "$text" }

[floating-panel-focused]
select = { kind = "FloatingPanel", states = ["FocusVisible"] }
style.paint.border = "$focus"

[axis-x]
select = { kind = "NumberField", classes = ["axis-x"] }
style.control.mark = "$axis_x"

[axis-y]
select = { kind = "NumberField", classes = ["axis-y"] }
style.control.mark = "$axis_y"

[axis-z]
select = { kind = "NumberField", classes = ["axis-z"] }
style.control.mark = "$axis_z"

[palette]
select = { classes = ["palette"] }
style.paint = { background = "$raised", border_width = 1, border = "$raised_border", radii = ["$radius_l", "$radius_l", "$radius_l", "$radius_l"], shadow = [{ color = "$shadow", offset = [0, "$shadow_y"], blur = "$shadow_blur", spread = 0 }] }
style.layout.padding = { start = "$space_s", end = "$space_s", top = "$space_s", bottom = "$space_s" }
style.layout.gap = ["$space_s", 0]

[palette-row-chosen]
select = { kind = "MenuItem", states = ["Selected"], inside = { class = "palette" } }
style.paint.background = "$accent_soft"

[sheet]
select = { classes = ["sheet"] }
style.paint = { background = "$raised", border_width = 1, border = "$raised_border", radii = ["$radius_l", "$radius_l", "$radius_l", "$radius_l"], shadow = [{ color = "$shadow", offset = [0, "$shadow_y"], blur = "$shadow_blur", spread = 0 }] }
style.layout.padding = { start = "$space_l", end = "$space_l", top = "$space_l", bottom = "$space_l" }
style.layout.gap = ["$space_xs", 0]

# A dialog over the window, as the one that waits for the system's dialog to open a level.
[dialog]
select = { classes = ["dialog"] }
style.paint = { background = "$raised", border_width = 1, border = "$raised_border", radii = ["$radius_l", "$radius_l", "$radius_l", "$radius_l"], shadow = [{ color = "$shadow", offset = [0, "$shadow_y"], blur = "$shadow_blur", spread = 0 }] }
style.layout.padding = { start = "$space_l", end = "$space_l", top = "$space_l", bottom = "$space_l" }
style.layout.gap = ["$space_m", "$space_m"]

[sheet-title]
select = { kind = "Label", classes = ["sheet-title"] }
style.text.style.weight = "$weight_title"

[sheet-scope]
select = { kind = "Label", classes = ["sheet-scope"] }
style.text = { style = { size = "$text_s", weight = "$weight_control" }, color = "$muted" }
style.layout.margin = { start = 0, end = 0, top = "$space_s", bottom = 0 }

[notification]
select = { classes = ["notification"] }
style.paint = { background = "$panel", border_width = 1, border = "$raised_border", radii = ["$radius_m", "$radius_m", "$radius_m", "$radius_m"], shadow = [{ color = "$shadow", offset = [0, "$shadow_y"], blur = "$shadow_blur", spread = 0 }] }
style.layout.padding = { start = "$space_m", end = "$space_s", top = "$space_s", bottom = "$space_m" }
style.layout.size = [{ Pixels = "$notification_width" }, "Auto"]

[notification-success]
select = { classes = ["notification", "success"] }
style.paint.border = "$success"

[notification-warning]
select = { classes = ["notification", "warning"] }
style.paint.border = "$warning"

[notification-error]
select = { classes = ["notification", "error"] }
style.paint.border = "$danger"

[notification-close]
select = { kind = "Button", classes = ["close"], inside = { class = "notification" } }
style.paint = { background = "$none", border = "$none" }
style.layout.padding = { start = "$space_xs", end = "$space_xs", top = 0, bottom = 0 }
style.text.color = "$muted"

[notification-close-hovered]
select = { kind = "Button", classes = ["close"], states = ["Hovered"], inside = { class = "notification" } }
style.text.color = "$text"

# A color well and its picker (docs/adr/0152-the-dev-overlay-on-the-engines-interface.md): the
# swatch inside a field's frame; the picker raised as a menu is; its square and strips rounded,
# ringed in the accent while the keyboard's focus is on them.
[color-well]
select = { kind = "ColorWell" }
style.paint = { background = "$field", border_width = 1, border = "$raised_border", radii = ["$radius_m", "$radius_m", "$radius_m", "$radius_m"] }
style.layout.padding = { start = 2, end = 2, top = 2, bottom = 2 }
style.control = { size = "$control", radius = "$radius_s", track = "$track", fill = "$accent", mark = "$mark" }

[color-well-focused]
select = { kind = "ColorWell", states = ["FocusVisible"] }
style.paint.border = "$focus"

[picker]
select = { classes = ["picker"] }
style.paint = { background = "$raised", border_width = 1, border = "$raised_border", radii = ["$radius_l", "$radius_l", "$radius_l", "$radius_l"], shadow = [{ color = "$shadow", offset = [0, "$shadow_y"], blur = "$shadow_blur", spread = 0 }] }
style.layout.padding = { start = "$space_m", end = "$space_m", top = "$space_m", bottom = "$space_m" }

[color-part]
select = { kind = "ColorPart" }
style.control = { size = "$control", radius = "$radius_s", track = "$track", fill = "$accent", mark = "$mark" }

# The dev overlay's panels (docs/adr/0152-the-dev-overlay-on-the-engines-interface.md): a list's
# rows, which select, the entity selected among them; references, which read as links; a heading;
# a refusal.
[row]
select = { kind = "Button", classes = ["row"] }
style.paint = { background = "$none", border = "$none", radii = ["$radius_s", "$radius_s", "$radius_s", "$radius_s"] }
style.layout.padding = { start = "$space_s", end = "$space_s", top = 0, bottom = 0 }

[row-hovered]
select = { kind = "Button", classes = ["row"], states = ["Hovered"] }
style.paint.background = "$hover"

[row-selected]
select = { kind = "Button", classes = ["row"], states = ["Selected"] }
style.paint.background = "$accent_soft"

# A row of what is undone, as the editor's history shows a step undone.
[row-undone]
select = { kind = "Button", classes = ["row", "undone"] }
style.text.color = "$muted"

[link]
select = { kind = "Button", classes = ["link"] }
style.paint = { background = "$none", border = "$none" }
style.layout.padding = { start = 0, end = 0, top = 0, bottom = 0 }
style.text.color = "$accent"

[link-hovered]
select = { kind = "Button", classes = ["link"], states = ["Hovered"] }
style.text.color = "$accent_hover"

[heading]
select = { kind = "Label", classes = ["heading"] }
style.text.style.weight = "$weight_title"

[refusal]
select = { kind = "Label", classes = ["error"] }
style.text.color = "$danger"

[fixed]
select = { classes = ["fixed"] }
style.text.style = { fonts = ["Geist Mono"], size = "$text_mono" }
